name: Repository Structure Validation

on:
  push:
    branches: [ main, develop, staging ]
  pull_request:
    branches: [ main, develop ]
  workflow_dispatch:

jobs:
  validate-structure:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
    
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '18'
    
    - name: Install validation dependencies
      run: |
        npm install -g yaml-lint
        npm install -g markdownlint-cli
    
    - name: Validate repository structure
      id: validate
      run: |
        echo "Starting repository validation..."
        
        RED='\033[0;31m'
        GREEN='\033[0;32m'
        YELLOW='\033[1;33m'
        NC='\033[0m'
        
        ERRORS=0
        WARNINGS=0
        
        echo -e "\n${YELLOW}Checking Required Directories...${NC}"
        
        directories=(
          "Database"
          "Documentation"
          "Scripts"
          ".github/workflows"
        )
        
        for dir in "${directories[@]}"; do
          if [ -d "$dir" ]; then
            echo -e "${GREEN}OK: $dir directory exists${NC}"
          else
            echo -e "${RED}ERROR: $dir directory is MISSING${NC}"
            ERRORS=$((ERRORS+1))
          fi
        done
        
        echo -e "\n${YELLOW}Checking Required Files...${NC}"
        
        if [ -f "Database/RaceDay.sql" ]; then
          echo -e "${GREEN}OK: Database/RaceDay.sql exists${NC}"
        else
          echo -e "${RED}ERROR: Database/RaceDay.sql is MISSING${NC}"
          ERRORS=$((ERRORS+1))
        fi
        
        doc_files=(
          "README.md"
          "CONTRIBUTING.md"
          "LICENSE"
          ".gitignore"
        )
        
        for file in "${doc_files[@]}"; do
          if [ -f "$file" ]; then
            echo -e "${GREEN}OK: $file exists${NC}"
          else
            echo -e "${RED}ERROR: $file is MISSING${NC}"
            ERRORS=$((ERRORS+1))
          fi
        done
        
        if [ -f "Documentation/API.pdf" ]; then
          echo -e "${GREEN}OK: Documentation/API.pdf exists${NC}"
        else
          echo -e "${YELLOW}WARNING: Documentation/API.pdf is MISSING (optional)${NC}"
          WARNINGS=$((WARNINGS+1))
        fi
        
        if [ -f "Documentation/ERD.png" ] || [ -f "Documentation/ERD.jpg" ] || [ -f "Documentation/ERD.svg" ]; then
          echo -e "${GREEN}OK: Documentation/ERD image exists${NC}"
        else
          echo -e "${YELLOW}WARNING: Documentation/ERD image is MISSING (optional)${NC}"
          WARNINGS=$((WARNINGS+1))
        fi
        
        echo -e "\n${YELLOW}Validating README.md Content...${NC}"
        
        if [ -f "README.md" ]; then
          if grep -q "## Overview" README.md; then
            echo -e "${GREEN}OK: README.md has Overview section${NC}"
          else
            echo -e "${RED}ERROR: README.md missing Overview section${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q "## Features" README.md; then
            echo -e "${GREEN}OK: README.md has Features section${NC}"
          else
            echo -e "${RED}ERROR: README.md missing Features section${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q "## Quick Start" README.md; then
            echo -e "${GREEN}OK: README.md has Quick Start section${NC}"
          else
            echo -e "${RED}ERROR: README.md missing Quick Start section${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q "## Database Schema" README.md; then
            echo -e "${GREEN}OK: README.md has Database Schema section${NC}"
          else
            echo -e "${RED}ERROR: README.md missing Database Schema section${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q "## API Endpoints" README.md; then
            echo -e "${GREEN}OK: README.md has API Endpoints section${NC}"
          else
            echo -e "${RED}ERROR: README.md missing API Endpoints section${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q "## CICD Pipeline" README.md || grep -q "## CI/CD Pipeline" README.md; then
            echo -e "${GREEN}OK: README.md has CI/CD section${NC}"
          else
            echo -e "${RED}ERROR: README.md missing CI/CD section${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q "## Video Demo" README.md || grep -q "## Video" README.md; then
            echo -e "${GREEN}OK: README.md has Video Demo section${NC}"
          else
            echo -e "${RED}ERROR: README.md missing Video Demo section${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q '!\[.*\](.*\.png\|.*\.jpg\|.*\.svg)' README.md; then
            echo -e "${GREEN}OK: README.md has images${NC}"
          else
            echo -e "${YELLOW}WARNING: README.md has no images${NC}"
            WARNINGS=$((WARNINGS+1))
          fi
        fi
        
        echo -e "\n${YELLOW}Validating GitHub Action Workflows...${NC}"
        
        if [ -d ".github/workflows" ]; then
          echo -e "${GREEN}OK: .github/workflows directory exists${NC}"
          
          workflow_files=$(ls -1 .github/workflows/*.yml 2>/dev/null || echo "")
          if [ -n "$workflow_files" ]; then
            echo -e "${GREEN}OK: GitHub Actions workflows found:${NC}"
            echo "$workflow_files" | while read -r file; do
              echo -e "  FILE: $(basename "$file")"
            done
          else
            echo -e "${RED}ERROR: No GitHub Actions workflows found${NC}"
            ERRORS=$((ERRORS+1))
          fi
        else
          echo -e "${RED}ERROR: .github/workflows directory is MISSING${NC}"
          ERRORS=$((ERRORS+1))
        fi
        
        echo -e "\n${YELLOW}Validating Scripts Directory...${NC}"
        
        if [ -d "Scripts" ]; then
          echo -e "${GREEN}OK: Scripts directory exists${NC}"
          
          sql_files=$(find Scripts -name "*.sql" 2>/dev/null | wc -l)
          if [ "$sql_files" -gt 0 ]; then
            echo -e "${GREEN}OK: Found $sql_files SQL scripts${NC}"
          else
            echo -e "${YELLOW}WARNING: No SQL scripts found in Scripts directory${NC}"
            WARNINGS=$((WARNINGS+1))
          fi
        fi
        
        echo -e "\n${YELLOW}Validating Database Script Content...${NC}"
        
        if [ -f "Database/RaceDay.sql" ]; then
          sql_file="Database/RaceDay.sql"
          
          if grep -q "CREATE TABLE" "$sql_file"; then
            echo -e "${GREEN}OK: SQL script has CREATE TABLE statements${NC}"
          else
            echo -e "${RED}ERROR: SQL script missing CREATE TABLE statements${NC}"
            ERRORS=$((ERRORS+1))
          fi
          
          if grep -q "CREATE.*PROCEDURE" "$sql_file" || grep -q "CREATE PROC" "$sql_file"; then
            echo -e "${GREEN}OK: SQL script has stored procedures${NC}"
          else
            echo -e "${YELLOW}WARNING: SQL script missing stored procedures${NC}"
            WARNINGS=$((WARNINGS+1))
          fi
          
          if grep -q "CREATE.*VIEW" "$sql_file" || grep -q "CREATE VIEW" "$sql_file"; then
            echo -e "${GREEN}OK: SQL script has views${NC}"
          else
            echo -e "${YELLOW}WARNING: SQL script missing views${NC}"
            WARNINGS=$((WARNINGS+1))
          fi
          
          if grep -q "INSERT INTO" "$sql_file"; then
            echo -e "${GREEN}OK: SQL script has sample data${NC}"
          else
            echo -e "${YELLOW}WARNING: SQL script missing sample data${NC}"
            WARNINGS=$((WARNINGS+1))
          fi
        fi
        
        echo -e "\n${YELLOW}Checking File Sizes...${NC}"
        
        if [ -f "Database/RaceDay.sql" ]; then
          size=$(du -h "Database/RaceDay.sql" | cut -f1)
          echo -e "${GREEN}OK: Database/RaceDay.sql size: $size${NC}"
          
          if [ "$(stat -c%s Database/RaceDay.sql)" -lt 1000 ]; then
            echo -e "${RED}ERROR: Database/RaceDay.sql appears to be too small${NC}"
            ERRORS=$((ERRORS+1))
          fi
        fi
        
        if [ -f "README.md" ]; then
          size=$(du -h "README.md" | cut -f1)
          echo -e "${GREEN}OK: README.md size: $size${NC}"
          
          if [ "$(stat -c%s README.md)" -lt 1000 ]; then
            echo -e "${RED}ERROR: README.md appears to be too short${NC}"
            ERRORS=$((ERRORS+1))
          fi
        fi
        
        echo -e "\n${YELLOW}Validation Summary${NC}"
        echo -e "============================================="
        echo -e "${RED}Errors:   $ERRORS${NC}"
        echo -e "${YELLOW}Warnings: $WARNINGS${NC}"
        echo -e "${GREEN}Total Checks: $((ERRORS + WARNINGS + 20))${NC}"
        echo -e "============================================="
        
        echo "errors=$ERRORS" >> $GITHUB_OUTPUT
        echo "warnings=$WARNINGS" >> $GITHUB_OUTPUT
        
        if [ $ERRORS -gt 0 ]; then
          echo -e "\n${RED}Validation FAILED! Please fix the errors above.${NC}"
          exit 1
        else
          echo -e "\n${GREEN}Validation PASSED! All checks completed successfully.${NC}"
        fi
    
    - name: Upload validation results
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: validation-results
        path: |
          README.md
          Database/RaceDay.sql
          .github/workflows/
          Documentation/
    
    - name: Create validation badge
      if: success()
      run: |
        echo "Repository validation passed!"
        echo "Results available in the Actions tab."
